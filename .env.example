# Copy to your environment (or a systemd EnvironmentFile) — never commit real values.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Comma-separated host names the app answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 = debug mode for local development only (also allows running without DJANGO_SECRET_KEY)
DJANGO_DEBUG=0
